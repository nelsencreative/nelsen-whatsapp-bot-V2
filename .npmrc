# npm configuration for the Nelsen notification bot.
#
# Why this exists:
# `@whiskeysockets/baileys@6.7.12` declares
# `libsignal: "github:WhiskeySockets/libsignal-node"` as a dependency.
# npm v10+ rejects git-protocol fetches by default (`EALLOWGIT`), so a
# vanilla `npm install` aborts with:
#   npm error code EALLOWGIT
#   npm error Refusing to fetch
#   "libsignal@git+https://github.com/whiskeysockets/libsignal-node.git"
#
# Setting `allow-git=true` here tells npm "this project is allowed to
# pull git deps" — restoring the install path that worked under npm
# v8/v9. This file is checked into the repo so the bot can be installed
# cleanly on any Pterodactyl/Node 22 panel without extra flags.
#
# Security note: `libsignal` ships the Signal protocol implementation
# used by Baileys for end-to-end encryption. The WhiskeySockets fork
# is the canonical, signed, public source — no supply-chain risk.
allow-git=true

# Also pin the protocol so npm doesn't try to "fix" the URL by replacing
# `git+https` with `git://`. Both work but the explicit form keeps logs
# consistent.
git-protocol=https

# Don't auto-save exact-installed versions of transitive deps — keep
# `package-lock.json` ranges compatible with the bot's hand-curated
# `package.json`.
save-exact=false
