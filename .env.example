# ───────────────────────────────────────────────────────────────────────
# Nelsen Notification Bot — environment variables
#
# Loaded via `dotenv` on startup. Pterodactyl-level env vars override
# the .env file (dotenv never overwrites an existing process.env entry).
#
# Required vars cause the bot to exit with a list of what's missing.
# Optional vars fall back to the documented defaults below.
# ───────────────────────────────────────────────────────────────────────

# --- Destination for outbound notifications ---
# Your personal number (085733370411) — format: digits only, country code 62.
NOTIFY_TARGET_NUMBER=6285733370411

# --- HTTP API protection ---
# Long random string (e.g. `openssl rand -hex 32`). Webhook callers must
# send `Authorization: Bearer <NOTIFY_API_SECRET>`.
NOTIFY_API_SECRET=change-me-to-a-long-random-string

# --- Supabase (for username + product-name resolution) ---
# Find at Supabase Dashboard → Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- HTTP server ---
# Port the Express server listens on for /health (UptimeRobot) and
# /notify (webhook receiver).
PORT=3000

# --- Logger ---
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Realtime notifications (default: enabled) ---
# When `true` (default), the bot subscribes to Supabase Realtime and
# receives INSERT events on `public.orders` and `public.invoices` via
# outbound WebSocket — this works on hosts where inbound HTTP from
# Supabase is blocked (e.g. Pterodactyl behind Cloudflare proxy that
# does not forward arbitrary ports).
#
# Set to `false` ONLY if you are deploying behind a public URL (Render,
# Vercel, Fly.io, etc.) and want Supabase Database Webhooks to deliver
# to /notify instead. Do not enable both at once — you'll get duplicate
# notifications.
BOT_REALTIME_ENABLED=true
